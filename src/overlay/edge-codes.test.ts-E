// @vitest-environment happy-dom
import { describe, expect, it } from 'vitest';
import { DEUTSCH } from '../annotations/profile.ts';
import type { Bbox, Mark, Transcript } from '../annotations/transcript.ts';
import type { LineBand, LineBox } from '../layout/types.ts';
import { estimateTextWidth } from './char-width.ts';
import { frameOf, lineAngleAt, lineTopAt } from './geometry.ts';
import { layoutOverlay } from './layout.ts';
import type { OverlayModel, TextItem } from './model.ts';

const lineBox = (value: LineBox): Bbox => value;

const PAGE = { width: 1000, height: 600 };
const HEIGHT = 50;
const PITCH = 70;
const SLOPE = 0.06;

function error(type: string, original: string, offset: number, correction = 'xy'): Mark {
  return { kind: 'error', type, original, correction, offset };
}

function sloping(index: number, x: number, width: number): LineBand {
  const y = 80 + index * PITCH;
  const points = [0, 0.5, 1].map((share) => ({
    x: x + width * share,
    y: y + width * share * SLOPE,
  }));
  return { top: points, height: HEIGHT };
}

function page(options: {
  readonly x: number;
  readonly width: number;
  readonly marks: readonly (readonly Mark[])[];
  readonly slope?: boolean;
}): Transcript {
  return {
    lines: options.marks.map((marks, index) => {
      const band = options.slope === true ? sloping(index, options.x, options.width) : undefined;
      return {
        number: index + 1,
        bbox: {
          x: options.x,
          y: band?.top[0]?.y ?? 80 + index * PITCH,
          width: options.width,
          height: HEIGHT,
          ...(band === undefined ? {} : { band }),
        },
        text: 'wa wb wc wd we wf',
        marks: [...marks],
      };
    }),
  };
}

function codes(model: OverlayModel): TextItem[] {
  return model.items.filter(
    (item): item is TextItem => item.kind === 'text' && item.role === 'code',
  );
}

function extent(item: TextItem): { left: number; right: number } {
  const width = estimateTextWidth(item.text, item.size);
  const left = item.anchor === 'end' ? item.x - width : item.x;
  return { left, right: left + width };
}

function expectInside(model: OverlayModel): void {
  for (const item of model.items) {
    if (item.kind !== 'text') continue;
    const { left, right } = extent(item);
    expect(left, item.text).toBeGreaterThanOrEqual(0);
    expect(right, item.text).toBeLessThanOrEqual(PAGE.width);
    expect(item.y, item.text).toBeGreaterThan(0);
    expect(item.y, item.text).toBeLessThan(PAGE.height);
  }
}

const single = [[error('R', 'wb', 3)], [error('G', 'wc', 6)], [error('Z', 'wd', 9)]];

describe('codes on a page whose text reaches the right edge', () => {
  const transcript = page({ x: 120, width: 860, marks: single, slope: true });
  const model = layoutOverlay(transcript, { page: PAGE, profile: DEUTSCH });

  it('moves them to the left margin with their whole width inside the page', () => {
    expect(codes(model)).toHaveLength(3);
    expectInside(model);
    for (const code of codes(model)) {
      expect(extent(code).right).toBeLessThan(120);
    }
  });
});

describe.each([
  ['right', 30, 780],
  ['left', 200, 780],
])('margin codes on the %s next to lines that fall to the right', (_side, x, width) => {
  const marks = [error('A', 'wf', 15, '')];
  const transcript = page({ x, width, marks: [marks, marks, marks, marks], slope: true });
  const model = layoutOverlay(transcript, { page: PAGE, profile: DEUTSCH });

  it('sits at the height of its own line at the position of the code', () => {
    const found = codes(model);
    expect(found).toHaveLength(4);
    expectInside(model);
    found.forEach((code, index) => {
      const frame = frameOf(transcript.lines[index]?.bbox ?? { x: 0, y: 0, width: 1, height: 1 });
      const { left, right } = extent(code);
      const top = lineTopAt(frame, (left + right) / 2);
      expect(code.y).toBeGreaterThan(top);
      expect(code.y).toBeLessThan(top + HEIGHT);
    });
  });
});

describe('codes on a page without any margin', () => {
  const transcript = page({ x: 5, width: 990, marks: single, slope: true });
  const model = layoutOverlay(transcript, { page: PAGE, profile: DEUTSCH });

  it('keeps every code inside the page', () => {
    expect(codes(model).length).toBeGreaterThan(0);
    expectInside(model);
  });
});

describe('several codes in the same line', () => {
  const crowd = [
    error('R', 'wa', 0),
    error('G', 'wb', 3),
    error('Z', 'wc', 6),
    error('A', 'wd', 9),
    error('W', 'we', 12),
    error('T', 'wf', 15),
  ];

  it.each([
    ['wide margin', 30, 800],
    ['text to the right edge', 30, 950],
    ['text to both edges', 5, 990],
  ])('stays inside the page with %s', (_name, x, width) => {
    const transcript = page({ x, width, marks: [crowd, crowd], slope: true });
    const model = layoutOverlay(transcript, { page: PAGE, profile: DEUTSCH });
    expect(codes(model).length).toBeGreaterThan(0);
    expectInside(model);
  });
});

describe('line frames beyond the line ends', () => {
  const band: LineBand = {
    top: [
      { x: 100, y: 200 },
      { x: 300, y: 220 },
      { x: 500, y: 240 },
    ],
    height: 40,
  };
  const frame = frameOf(lineBox({ x: 100, y: 200, width: 400, height: 40, band }));

  it('continues the line with its trend to the right and to the left', () => {
    expect(lineTopAt(frame, 300)).toBeCloseTo(220);
    expect(lineTopAt(frame, 600)).toBeCloseTo(250);
    expect(lineTopAt(frame, 50)).toBeCloseTo(195);
    expect(lineAngleAt(frame, 600)).toBeCloseTo((Math.atan(0.1) * 180) / Math.PI);
  });

  it('stays flat for lines without a band', () => {
    const flat = frameOf({ x: 100, y: 200, width: 400, height: 40 });
    expect(lineTopAt(flat, 900)).toBe(200);
    expect(lineAngleAt(flat, 900)).toBe(0);
  });
});
