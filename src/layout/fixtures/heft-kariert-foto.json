    {
      "text": "mit der Klasse ins Schullandheim. Ich hoffe",
      "bbox": [100.6, 491.2, 449.5, 55.2]
    },
    {
      "text": "das ich mit meiner besten Freundin in ein",
      "bbox": [105.7, 521.4, 417.2, 49.4]
    },
    {
      "text": "Zimmer komme.",
      "bbox": [104.0, 569.9, 158.9, 28.3]
