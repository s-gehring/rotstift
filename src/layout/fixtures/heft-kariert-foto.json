    {
      "text": "Geburtstag! Über das Buch habe ich mich",
      "bbox": [86.9, 222.3, 427.4, 55.2]
    },
    {
      "text": "sehr gefreud. Ich habe schon fast die hälfte",
      "bbox": [80.2, 247.0, 447.7, 58.0]
