{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rotstift",
  "version": "0.1.0",
  "identifier": "tv.gehring.rotstift",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rotstift",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Lokale KI-Korrektur von Schülerarbeiten",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/rotstift-llama-server"],
    "resources": { "binaries/llama/*": "llama/" },
    "linux": {
      "deb": { "depends": ["libgomp1", "libssl3", "libstdc++6 (>= 12)"] },
      "rpm": { "depends": ["libgomp", "openssl-libs >= 3", "libstdc++ >= 12"] }
    },
    "publisher": "Simon Gehring",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
