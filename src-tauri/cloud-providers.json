{
  "templates": [
    {
      "id": "ionos",
      "label": "IONOS AI Model Hub",
      "baseUrl": "https://openai.inference.de-txl.ionos.com/v1",
      "key": "required",
      "tokenField": "max_tokens"
    },
    {
      "id": "mistral",
      "label": "Mistral AI",
      "baseUrl": "https://api.mistral.ai/v1",
      "key": "required",
      "tokenField": "max_tokens"
    },
    {
      "id": "stackit",
      "label": "STACKIT AI Model Serving",
      "baseUrl": "https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1",
      "key": "required",
      "tokenField": "max_tokens"
    },
    {
      "id": "anthropic",
      "label": "Anthropic",
      "baseUrl": "https://api.anthropic.com/v1",
      "key": "required",
      "tokenField": "max_tokens",
      "api": "anthropic"
    },
    {
      "id": "openai",
      "label": "OpenAI",
      "baseUrl": "https://api.openai.com/v1",
      "key": "required",
      "tokenField": "max_completion_tokens"
    },
    {
      "id": "openai-eu",
      "label": "OpenAI (EU-Projekt)",
      "baseUrl": "https://eu.api.openai.com/v1",
      "key": "required",
      "tokenField": "max_completion_tokens"
    },
    {
      "id": "claude-code",
      "label": "Claude-Abo (Claude Code)",
      "shortLabel": "Claude-Abo",
      "baseUrl": "cli://claude",
      "key": "none",
      "tokenField": "max_tokens",
      "api": "cli",
      "cli": {
        "adapter": "claude",
        "models": ["sonnet", "opus", "haiku"],
        "install": "curl -fsSL https://claude.ai/install.sh | bash",
        "login": "claude auth login"
      }
    },
    {
      "id": "codex",
      "label": "ChatGPT-Abo (Codex, ungetestet)",
      "shortLabel": "ChatGPT-Abo",
      "baseUrl": "cli://codex",
      "key": "none",
      "tokenField": "max_tokens",
      "api": "cli",
      "cli": {
        "adapter": "codex",
        "models": ["gpt-6-luna", "gpt-6.1-sol", "gpt-6-astra"],
        "install": "npm install -g @openai/codex",
        "login": "codex login",
        "hint": "Dieser Weg wurde noch nie mit einer echten Codex-Installation ausprobiert. Die Anmeldung muss mit dem ChatGPT-Konto erfolgen, nicht mit einem API-Schlüssel, sonst rechnet Codex darüber ab."
      }
    },
    {
      "id": "server",
      "label": "Eigener Server",
      "baseUrl": null,
      "key": "optional",
      "tokenField": "max_tokens"
    },
    {
      "id": "custom",
      "label": "Anderer Anbieter",
      "baseUrl": null,
      "key": "optional",
      "tokenField": "max_tokens"
    }
  ]
}
